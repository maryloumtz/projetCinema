{% extends 'base-client.html.twig' %}

{% block title %}CinePulse - {{ film.Nom }}{% endblock %}

{% block body %}

<div class="">
    <div class="flex flex-row items-start gap-6 h-133 pt-24">
        <svg xmlns="http://www.w3.org/2000/svg" version="1.0" width="512.000000pt" height="512.000000pt" viewBox="0 0 512.000000 512.000000" preserveAspectRatio="xMidYMid meet" class="absolute right-16 top-16 w-48 h-48 z-0 opacity-7.5 -rotate-30">
            <g transform="translate(0.000000,512.000000) scale(0.100000,-0.100000)" fill="#fff" stroke="none">
                <path d="M3820 4954 c-2950 -1192 -3131 -1264 -3190 -1264 -71 0 -116 -27 -148 -90 -22 -44 -22 -49 -22 -457 0 -325 3 -421 14 -446 19 -47 79 -96 126 -103 l40 -7 0 -1151 c0 -1280 -4 -1207 68 -1301 27 -36 57 -60 106 -85 l69 -35 1677 0 1677 0 69 35 c49 25 79 49 105 84 73 97 69 17 69 1300 l0 1152 43 11 c57 15 95 47 118 97 16 35 19 68 19 224 0 143 -3 191 -15 220 -17 40 -48 77 -80 95 -15 9 -423 13 -1574 17 -1023 3 -1555 8 -1558 15 -1 6 655 275 1460 599 804 324 1489 601 1522 617 77 36 115 89 115 162 0 68 -126 380 -169 419 -31 28 -87 48 -131 48 -14 -1 -198 -71 -410 -156z m573 -209 c39 -98 40 -120 8 -149 -17 -16 -183 -87 -189 -81 -5 4 131 325 138 325 3 0 23 -43 43 -95z m-755 -217 c-66 -156 -125 -288 -132 -295 -13 -14 -386 -165 -396 -161 -6 3 214 530 236 566 8 11 381 170 405 172 4 0 -47 -127 -113 -282z m-1103 -439 c-64 -151 -122 -282 -128 -293 -12 -17 -397 -179 -406 -170 -4 4 228 555 241 569 8 10 400 173 406 169 2 -1 -49 -125 -113 -275z m-1084 -394 c-50 -118 -102 -240 -116 -271 l-25 -56 -158 145 c-87 79 -167 150 -178 156 -10 7 -14 14 -9 17 50 24 571 231 574 229 2 -2 -38 -101 -88 -220z m-663 -227 c7 -7 12 -24 12 -38 0 -14 -5 -31 -12 -38 -17 -17 -78 -15 -100 5 -22 20 -23 32 -2 61 17 25 81 31 102 10z m812 -321 c0 -2 -13 -16 -29 -31 l-29 -27 -4 30 c-4 29 -3 31 29 31 18 0 33 -1 33 -3z m380 -222 l-225 -225 -106 0 -106 0 4 123 5 122 101 103 102 102 225 0 225 0 -225 -225z m1194 0 l-217 -225 -226 0 -226 0 225 225 225 225 218 0 219 0 -218 -225z m1351 204 l27 -22 -203 -203 -204 -204 -225 0 -225 0 225 225 225 225 176 0 c165 0 178 -1 204 -21z m-3743 -231 c43 -33 14 -98 -43 -98 -31 0 -69 30 -69 55 0 43 75 71 112 43z m533 -4 c41 -42 -14 -109 -72 -88 -38 13 -53 56 -28 84 22 24 77 27 100 4z m3053 -1473 l-3 -1169 -30 -43 c-16 -23 -50 -53 -74 -66 l-44 -23 -1657 0 -1657 0 -44 23 c-24 13 -57 43 -74 66 l-30 43 -3 1169 -2 1169 1810 0 1810 0 -2 -1169z"/>
                <path d="M1088 2268 c-28 -22 -31 -55 -9 -77 21 -21 22 -21 1481 -21 1459 0 1460 0 1481 21 22 22 19 55 -9 77 -23 18 -2921 18 -2944 0z"/>
                <path d="M1074 1715 c-15 -23 -15 -27 0 -50 l16 -25 1470 0 1470 0 16 25 c15 23 15 27 0 50 l-16 25 -1470 0 -1470 0 -16 -25z"/>
                <path d="M1098 1199 c-32 -18 -41 -48 -23 -75 l15 -24 460 0 460 0 0 -313 c0 -303 1 -315 20 -332 16 -15 26 -17 48 -9 l27 9 3 323 2 322 450 0 450 0 2 -322 3 -323 27 -9 c22 -8 32 -6 48 9 19 17 20 29 20 332 l0 313 460 0 460 0 15 24 c19 28 9 58 -25 76 -26 14 -2898 13 -2922 -1z"/>
            </g>
        </svg>
        <div class="container-photo-affiche">
            {% if film.Image %}
                <img src="{{ film.Image }}" alt="Affiche de {{ film.Nom }}" class="img-movie object-cover object-center w-200 h-133 absolute left-0 top-0">
                <div class="w-200 h-133 absolute left-0 top-0">
                    <div class="overlay-movie"></div>
                </div>
            {% else %}
                <div class="w-200 h-133 bg-gray-700 flex items-center justify-center">
                    <span class="text-gray-500">No Image</span>
                </div>
            {% endif %}
        </div>
        <div class="w-4/10 ml-auto">
            <div class="flex flex-col gap-11">
                {% if film.Categorie|length > 0 %}
                    <div class="flex flex-row flex-wrap gap-2 mt-3">
                        {% for categorie in film.Categorie %}
                            <span class="px-3 py-1 text-xs font-semibold border-2 rounded-full {{ categorie.Nom }}">
                                {{ categorie.Nom }}
                            </span>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="flex flex-col gap-1">
                    <h1 class="text-5xl font-title w-full">{{ film.Nom }}</h1>
                    <div class="flex flex-row items-center gap-4">
                        <p class="text-sm">{{ filmDuration }}</p>
                        <span class="w-[5px] h-[6px] rounded-2xl bg-white"></span>
                        <p class="text-sm">{{ film.Realisateur }}</p>
                        {% if film.LimiteAge %}
                            <span class="w-[5px] h-[6px] rounded-2xl bg-white"></span>
                            <p class="text-sm">{{ film.LimiteAge }}+</p>
                        {% endif %}
                    </div>
                </div>
                <div class=""> 
                    <div id="description-container">
                        <p class="text-sm" id="description-text">
                            <span id="description-static">{{ film.Description[:300] }}</span><span id="description-extra" class="hidden transition-all duration-300 ease-in-out">{{ film.Description[300:] }}</span>
                        </p>
                        {% if film.Description|length > 300 %}
                            <button id="toggle-description" class=" text-[10px] mb-4">
                                Lire plus +
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="flex flex-row justify-between items-center mt-48">
    <div class="w-5/10 h-auto">
        <img src="../images/cinema-form.png" alt="Cinéma" class="object-cover rounded-lg shadow-lg">
    </div>
    
    <div class="w-4/10 ml-auto h-auto pl-10">
        {{ render(controller('App\\Controller\\HomeClientController::contact')) }}
    </div>
</div>

<script>
    const toggleBtn = document.getElementById('toggle-description');
    const descriptionExtra = document.getElementById('description-extra');
    
    if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
            const isHidden = descriptionExtra.classList.contains('hidden');
            
            if (isHidden) {
                // Afficher le texte supplémentaire
                descriptionExtra.classList.remove('hidden');
                descriptionExtra.classList.remove('hiding');
                
                toggleBtn.textContent = 'Lire moins -';
            } else {
                // Masquer le texte supplémentaire
                descriptionExtra.classList.add('hiding');
                
                setTimeout(() => {
                    descriptionExtra.classList.add('hidden');
                    descriptionExtra.classList.remove('hiding');
                }, 600);
                
                toggleBtn.textContent = 'Lire plus +';
            }
        });
    }
</script>

{% endblock %}
