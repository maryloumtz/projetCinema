{% extends 'espace-admin/layout.html.twig' %}

{% set page_title = 'Accueil' %}
{% set active_nav = 'accueil' %}

{% block title %}Espace admin - Accueil{% endblock %}

{% block admin_content %}
    <section class="admin-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 auto-rows-[360px] gap-8">
        <div class="md:col-span-2 xl:col-span-1 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-[0_16px_40px_rgba(0,0,0,0.25)] p-4 flex flex-col gap-4 h-[360px]" data-seance-filter>
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-sm text-slate-400">Séances du jour</p>
                    <h2 class="text-lg font-semibold text-slate-100">{{ today|date('d/m/Y') }}</h2>
                </div>
                <div class="text-xs text-slate-400 whitespace-nowrap">{{ seances_du_jour|length }} séance(s)</div>
            </div>
            <div class="flex flex-col gap-3">
                {% if seances_du_jour is empty %}
                    <div class="admin-empty">Aucune séance n'est programmée aujourd'hui.</div>
                {% else %}
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="rounded-full border border-orange-400 bg-gradient-to-br from-orange-400 to-orange-600 px-3 py-1 text-xs font-semibold text-neutral-900 shadow-[0_10px_20px_rgba(249,115,22,0.25)] transition" data-salle-chip="all">Toutes</button>
                        {% for numero in salles_du_jour %}
                            <button type="button" class="rounded-full border border-slate-700/80 bg-neutral-900 px-3 py-1 text-xs font-medium text-slate-200 transition hover:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-500/40" data-salle-chip="{{ numero }}">Salle {{ numero }}</button>
                        {% endfor %}
                    </div>
                    <div class="list-seances flex flex-col gap-2 pr-1">
                        {% for seanceFilm in seances_du_jour %}
                            {% set seance = seanceFilm.seance %}
                            <div class="relative rounded-xl border border-neutral-800 bg-neutral-950 bg-cover bg-center p-3" data-salle-item="{{ seanceFilm.salle ? seanceFilm.salle.numero : 'unknown' }}" style="background-image: url('{{ seanceFilm.film and seanceFilm.film.image ? seanceFilm.film.image : '' }}')">
                                <div class="absolute inset-0 bg-black/60"></div>
                                <div class="relative z-10 flex items-start justify-between gap-3">
                                    <div>
                                        <p class="text-[11px] uppercase tracking-wide text-slate-200/80">
                                        {{ seance.date ? seance.date|date('d/m/Y') : 'Date a definir' }} ·
                                        {{ seance.horaireDebut ? seance.horaireDebut|date('H:i') : '--:--' }}
                                        {% if seance.horaireFin %} - {{ seance.horaireFin|date('H:i') }}{% endif %}
                                        </p>
                                        <h3 class="text-base font-semibold text-slate-100">{{ seanceFilm.film ? seanceFilm.film.nom : 'Film supprime' }}</h3>
                                        <p class="text-xs text-slate-200/80"><span>{{ seanceFilm.version }}</span></p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="rounded-full border border-slate-700/80 bg-neutral-900/80 px-3 py-1 text-xs text-slate-100">Salle {{ seanceFilm.salle ? seanceFilm.salle.numero : '?' }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <script>
                        (() => {
                            const container = document.querySelector('[data-seance-filter]');
                            if (!container) {
                                return;
                            }
                            const chips = Array.from(container.querySelectorAll('[data-salle-chip]'));
                            const items = Array.from(container.querySelectorAll('[data-salle-item]'));
                            if (!chips.length || !items.length) {
                                return;
                            }

                            const inactiveClasses = ['bg-neutral-900', 'text-slate-200', 'border-slate-700/80'];
                            const activeClasses = ['bg-gradient-to-br', 'from-orange-400', 'to-orange-600', 'text-neutral-900', 'border-orange-400', 'shadow-[0_10px_20px_rgba(249,115,22,0.25)]'];

                            const setChipState = (chip, isActive) => {
                                inactiveClasses.forEach((className) => {
                                    chip.classList.toggle(className, !isActive);
                                });
                                activeClasses.forEach((className) => {
                                    chip.classList.toggle(className, isActive);
                                });
                                chip.classList.toggle('font-semibold', isActive);
                                chip.classList.toggle('font-medium', !isActive);
                            };

                            const setActive = (value) => {
                                chips.forEach((chip) => {
                                    setChipState(chip, chip.dataset.salleChip === value);
                                });
                                items.forEach((item) => {
                                    const matches = value === 'all' || item.dataset.salleItem === value;
                                    item.style.display = matches ? '' : 'none';
                                });
                            };

                            chips.forEach((chip) => {
                                chip.addEventListener('click', () => {
                                    setActive(chip.dataset.salleChip || 'all');
                                });
                            });
                        })();
                    </script>
                {% endif %}
            </div>
        </div>
        <div class="md:col-span-2 xl:col-span-1 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-[0_16px_40px_rgba(0,0,0,0.25)] p-4 flex flex-col gap-4 h-[360px]">
            <p class="text-sm text-slate-400">Sorties à venir</p>
        </div>
        <div class="xl:col-span-1 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-[0_16px_40px_rgba(0,0,0,0.25)] p-4 flex flex-col gap-4 h-[360px]">
            <p class="text-sm text-slate-400">Offres en cours</p>
        </div>
        <div class="xl:col-span-1 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-[0_16px_40px_rgba(0,0,0,0.25)] p-4 flex flex-col gap-4 h-[360px]">
            <p class="text-sm text-slate-400">Chiffre d'affaire du mois</p>
        </div>
    </section>
{% endblock %}
